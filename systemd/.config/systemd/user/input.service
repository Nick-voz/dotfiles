[Unit]
Description=Input terminal (prewarmed kitty window for raw text prompts)
After=graphical-session.target
PartOf=graphical-session.target
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/bin/kitty --class input -e /usr/bin/bash %h/.config/awesome/scripts/menu --class input
Restart=always
RestartSec=100ms
TimeoutStopSec=5s

[Install]
WantedBy=graphical-apps.target
