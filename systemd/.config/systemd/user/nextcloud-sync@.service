[Unit]
Description=Nextcloud sync: %i

[Service]
Type=oneshot
EnvironmentFile=%h/.config/nextcloudcmd/credentials.env
# daily nextcloudcmd logs all internal info/debug to journald natively
# (bypasses --silent); propagator also logs every ignored file (".obsidian")
# as a warning. Real failures still surface via unit exit code.
Environment=QT_LOGGING_RULES=*.debug=false;*.info=false;nextcloud.sync.propagator=false
# No network-online.target in the user manager. Exit 0 to skip rather than
# fail the unit, so the next minute's trigger still fires.
# Sync runs are serialized by an exclusive lock on %t/nextcloud-sync.lock:
# nextcloudcmd reads/writes the shared ~/.config/Nextcloud/nextcloud.cfg, so
# two instances must not run concurrently (timers are also staggered, this is
# the guarantee for long syncs). If the lock is held, this run exits 0 and the
# next minute's trigger fires again.
ExecStart=/bin/sh -c 'exec 9>"%t/nextcloud-sync.lock"; flock -n 9 || exit 0; nmcli -t -f CONNECTIVITY general | grep -qx full || exit 0; exec /usr/bin/nextcloudcmd --non-interactive --path %i %h/%i https://cloud.nikvoz.ru/'
TimeoutStartSec=30min
Nice=10
IOSchedulingClass=idle
