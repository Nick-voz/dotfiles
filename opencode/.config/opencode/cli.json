{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "catppuccin-frappe"
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": false,
    "thinking": "hide",
    "new_location": "launch",
    "markdown": "rendered",
    "verbosity": "high",
    "permissions": "prompt",
    "image_preview": true
  },
  "animations": true,
  "tabs": {
    "mode": "on",
    "layout": "horizontal",
    "indicators": "status",
    "scope": "cwd"
  }
}
