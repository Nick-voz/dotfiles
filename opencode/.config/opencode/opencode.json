{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "firefox-devtools": {
      "type": "local",
      "command": ["npx", "-y", "@mozilla/firefox-devtools-mcp@latest", "--auto-profile"],
      "enabled": true
    }
  },
  "permission": {
    "bash": {
      "git push": "ask",
      "git status": "allow",
      "git diff": "allow",
      "git log": "allow",
      "git commit": "ask",
      "git add": "ask",
      "ls": "allow",
      "pwd": "allow"
    }
  }
}
